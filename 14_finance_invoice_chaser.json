      "id": "164b9f8b-398e-4dbd-ad57-17483d8b972c",
      "name": "Read invoices",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const today = $now.startOf('day');\nconst out = [];\nfor (const { json: r } of $input.all()) {\n  if (String(r['Status']).toLowerCase() === 'paid' || !r['Due date'] || !r['Email']) continue;\n  const days = Math.floor(today.diff(DateTime.fromISO(String(r['Due date'])), 'days').days);\n  if (days < 1) continue;\n  if (r['Last reminder'] === today.toISODate()) continue;\n  const tone = days <= 7 ? 'friendly' : days <= 21 ? 'firm' : 'final';\n  out.push({ json: { ...r, days_overdue: days, tone, reminders: Number(r['Reminders sent'] || 0) } });\n}\nreturn out;"
      },
      "id": "dc997e0c-2cb2-4ca3-9f6d-d70088c9cd11",
      "name": "Find overdue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You write payment reminder emails for Northwind Studio (a small agency).\n\nInvoice {{ $json['Invoice No'] }} for {{ $json['Amount'] }} to {{ $json['Client'] }} (contact: {{ $json['Contact name'] }}) was due on {{ $json['Due date'] }}. It is {{ $json.days_overdue }} days overdue. Reminders already sent: {{ $json.reminders }}.\n\nTone: {{ $json.tone }}.\n- friendly: assume they forgot, short and warm.\n- firm: clear, mention the due date and ask for a payment date.\n- final: polite but serious, say work may pause and late fees may apply per our terms.\n\nMax 120 words. No guilt-tripping. Return a subject and a plain-text body signed 'Accounts, Northwind Studio'.",
        "hasOutputParser": true
      },
      "id": "b6ae7e07-fb88-452c-847b-4770ba7cc7f2",
      "name": "Claude writes reminder",
