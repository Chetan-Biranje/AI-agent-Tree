      "id": "db67c0c7-a534-4709-bd69-f86dcb27771a",
      "name": "Wait for both",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Deadlines tab: Filing (e.g. GSTR-3B), Due date (yyyy-mm-dd), Applies to (service tag, e.g. GST)\n// Clients tab: Client, Phone, Services (comma tags, e.g. GST, ITR, TDS), Status\nconst today = $now.setZone('Asia/Kolkata').startOf('day');\nconst ALERT_DAYS = [7, 3, 1];\nconst out = [];\nfor (const { json: d } of $('Deadlines').all()) {\n  if (!d['Due date']) continue;\n  const left = Math.round(DateTime.fromISO(d['Due date']).diff(today, 'days').days);\n  if (!ALERT_DAYS.includes(left)) continue;\n  for (const { json: cl } of $('Active clients').all()) {\n    const tags = String(cl.Services || '').split(',').map(s => s.trim());\n    if (!cl.Phone || !tags.includes(d['Applies to'])) continue;\n    out.push({ json: { Phone: cl.Phone, Client: cl.Client, Filing: d.Filing, Due: DateTime.fromISO(d['Due date']).toFormat('d LLL'), left,\n      msg: `⏰ ${cl.Client} ji, *${d.Filing}* ki last date *${DateTime.fromISO(d['Due date']).toFormat('d LLL')}* hai (${left} din baaki).\\n` +\n           (left === 1 ? 'Kal last date hai – late fee se bachne ke liye aaj hi documents bhej dijiye 🙏' : 'Documents jaldi bhej dijiye taaki time pe file ho jaye.') } });\n  }\n}\nreturn out;"
      },
