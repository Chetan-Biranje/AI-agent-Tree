        180,
        220
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "YOUR_GOOGLE_SHEET_URL"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "FAQ"
        },
        "options": {},
        "descriptionType": "manual",
        "toolDescription": "business FAQ: question / answer rows written by the firm (fees, deadlines, documents, timings)."
      },
      "id": "f8fdcd5f-f2f8-4256-b0fe-7b3f9c22928c",
      "name": "Firm FAQ sheet",
      "type": "n8n-nodes-base.googleSheetsTool",
      "typeVersion": 4.5,
      "position": [
        380,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.output || $json.text || '';\nconst m = raw.match(/\\{[\\s\\S]*\\}/);\nreturn { json: m ? JSON.parse(m[0]) : { reply: 'Ek minute, hamari team aapko call karegi 🙏', handoff: true, topic: 'other' } };",
        "mode": "runOnceForEachItem"
      },
      "id": "6b60ff78-bc89-4744-b566-40b52d860a00",
      "name": "Parse JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ]
    },
