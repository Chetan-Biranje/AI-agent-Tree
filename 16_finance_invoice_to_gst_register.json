        "textBody": "=⚠️ {{ $('GSTIN + maths check').item.json.Client }} – invoice {{ $('GSTIN + maths check').item.json['Invoice no'] }} ({{ $('GSTIN + maths check').item.json.Supplier }}): {{ $('GSTIN + maths check').item.json.Check }}. Please check before ITC claim.",
