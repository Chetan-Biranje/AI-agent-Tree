{
  "name": "12 · Review Asker (Kaamchor AI · MAP 2.0 · Marketing)",
  "nodes": [
    {
      "parameters": {
        "content": "## 12 · Review Collector\nVisit ke din raat ko rating poochta hai. 4-5 ⭐ → Google review link. 1-3 → review nahi maangta, owner ko private alert + sorry reply.\n\n**Setup (10 min)**\n1. WhatsApp nodes: **WhatsApp Business Cloud API** credential + your **Phone Number ID** (replace YOUR_PHONE_NUMBER_ID).\n2. Google Sheets: **Google Sheets OAuth2** credential, paste your sheet URL in place of YOUR_GOOGLE_SHEET_URL. Tab **Visits** (same as 06).\n3. Replace YOUR_GOOGLE_REVIEW_LINK (Google Business Profile → Ask for reviews) and YOUR_OWNER_WHATSAPP.\n4. AI model: **Anthropic** credential (or swap the model node for OpenAI / Gemini).",
        "height": 500,
        "width": 360,
        "color": 5
      },
      "id": "6f319c7a-cb7e-4120-b89a-afd262d4ada8",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -400,
        -480
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 20,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "87a0b21b-c8fd-41b8-80a9-c12ce5690bc1",
      "name": "Daily 8 PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        -160
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "YOUR_GOOGLE_SHEET_URL"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Visits"
        },
        "options": {},
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "Visit date",
              "lookupValue": "={{ $now.setZone('Asia/Kolkata').toFormat('yyyy-LL-dd') }}"
            }
          ]
        }
      },
      "id": "e4035349-85aa-43ae-857b-58443fe9e168",
      "name": "Today's visits",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        -160
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "YOUR_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $json.Phone }}",
        "textBody": "={{ $json.Name }} ji, aaj YOUR BUSINESS NAME aane ke liye shukriya 🙏 Aapka experience 1 se 5 mein kaisa raha? (bas number reply kijiye)",
        "additionalFields": {}
      },
      "id": "2a465669-d191-408b-a711-4b3537f3b49b",
      "name": "Ask rating",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        440,
        -160
      ]
    },
    {
      "parameters": {
        "updates": [
          "messages"
        ]
      },
      "id": "7f5ff2f2-c0f1-4cca-8b4f-e3fefdbbf686",
      "name": "Customer replies",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const t = $json.messages?.[0]?.text?.body || '';\nconst n = Number((t.match(/[1-5]/) || [])[0] || 0);\nreturn { json: { phone: $json.messages?.[0]?.from, name: $json.contacts?.[0]?.profile?.name || '', rating: n, text: t } };",
        "mode": "runOnceForEachItem"
      },
      "id": "5ba27650-b1c9-44b6-a1a6-2160cdf7cf18",
      "name": "Read rating",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.rating >= 4 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ac08d808-3cfe-45c5-bf70-0b12ab435bbd",
      "name": "Happy (4-5)?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "YOUR_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $json.phone }}",
        "textBody": "=Bahut shukriya {{ $json.name }} ji! 😊 Agar 30 second hain, Google pe ek review de dijiye – doosre customers ki bahut madad hoti hai:\nYOUR_GOOGLE_REVIEW_LINK",
        "additionalFields": {}
      },
      "id": "0b797e4d-c291-48ab-ad8b-fdd800b80126",
      "name": "Send Google review link",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        660,
        100
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=A business customer rated their visit {{ $json.rating }}/5 and wrote: \"{{ $json.text }}\". Write (1) a 1-line summary of the problem for the owner, (2) a polite Hinglish apology reply asking what went wrong. Do not ask for a review.",
        "hasOutputParser": true
      },
      "id": "9900be87-40fe-4fad-860f-85ff47951a0d",
      "name": "AI summarises issue",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "claude-sonnet-5-5",
          "mode": "id"
        },
        "options": {
          "temperature": 0.3
        }
      },
      "id": "5afc51d5-e383-43f5-9b46-49c49eae48fb",
      "name": "AI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        660,
        520
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"owner_summary\": \"Rated 2/5 \\u2013 waited long\",\n  \"reply\": \"Sorry ji \\ud83d\\ude4f Kya galat hua, bataiye \\u2013 owner khud dekhenge.\"\n}"
      },
      "id": "24a0e417-307e-47e0-bf08-cd18a8c56895",
      "name": "JSON shape",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        860,
        520
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "YOUR_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "=YOUR_OWNER_WHATSAPP",
        "textBody": "=👎 {{ $json.output.owner_summary }} – {{ $('Read rating').item.json.phone }}",
        "additionalFields": {}
      },
      "id": "ace92868-d3ac-4a93-94ed-24b2d9df6707",
      "name": "Private alert to owner",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "YOUR_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $('Read rating').item.json.phone }}",
        "textBody": "={{ $('AI summarises issue').item.json.output.reply }}",
        "additionalFields": {}
      },
      "id": "054f4a2e-3a80-4a06-8a43-c2e8fc6a4f24",
      "name": "Sorry reply",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        1180,
        300
      ]
    }
  ],
