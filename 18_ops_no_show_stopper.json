      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "YOUR_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $json.phone }}",
        "textBody": "={{ $json.name }} ji, reminder: aapka appointment *{{ $json.when }}* ko hai – YOUR BUSINESS NAME.\nReply *1* = aa raha hoon ✅  ·  *2* = cancel ❌",
        "additionalFields": {}
      },
