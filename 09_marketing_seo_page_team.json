      },
      "id": "8d44cc43-8881-4860-aae5-32975c35e65d",
      "name": "Claude (writer)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        2300,
        220
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"title\": \"Same-Day Plumber in Austin, Round Rock & Kyle\",\n  \"slug\": \"same-day-plumber-austin\",\n  \"meta_description\": \"Need a plumber today? ...\",\n  \"html\": \"<h2>...</h2><p>...</p>\"\n}"
      },
      "id": "e90364f9-b3b3-4a77-aceb-2461890c20ea",
      "name": "Page output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        2440,
        220
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a strict editor agent. Check this page against the brief and SEO best practice for Google and AI search (ChatGPT, Gemini).\n\nTARGET SEARCH: {{ $('Prep brief').first().json.keyword }}\nTOWNS: {{ $('Prep brief').first().json.towns }}\nBUSINESS FACTS: {{ $('Your business').first().json.facts }}\n\nPAGE TITLE: {{ $json.output.title }}\nPAGE HTML:\n{{ $json.output.html }}\n\nFail the page if: the title doesn't contain the service + a location, any listed town is missing, it states anything not in the facts, the FAQ is missing, or there's no call-to-action. passes = true only if everything is fine. List each problem in fixes.",
        "hasOutputParser": true
      },
      "id": "e855abb6-2ce4-403e-a7e7-05d38cf82bbb",
      "name": "Editor agent",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        2740,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "claude-sonnet-5-5",
          "mode": "id"
        },
        "options": {
          "temperature": 0.4
        }
      },
      "id": "52bfbd23-9546-4a60-a6cd-7508ead9db6a",
      "name": "Claude (editor)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        2700,
        220
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"passes\": false,\n  \"fixes\": [\n    \"Title is missing the town\",\n    \"Kyle is not mentioned\"\n  ]\n}"
      },
      "id": "01f40103-9852-4b82-9a31-860b51b7f3e2",
      "name": "Check output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        2840,
