              "value": "plumber",
              "type": "string"
            },
            {
              "id": "493916b3-adfa-4536-bab5-22dc9bae1df5",
              "name": "city",
              "value": "Austin, TX",
              "type": "string"
            },
            {
              "id": "f3548770-4050-45bc-93b5-0c5b0829b37a",
              "name": "towns",
              "value": "Austin, Round Rock, Kyle",
              "type": "string"
            },
            {
              "id": "3e86b7b1-c506-40df-8356-d1da836dee9d",
              "name": "facts",
              "value": "Phone: (000) 000-0000. Open Mon–Sat 7am–7pm. Same-day visits when booked before noon. Licensed and insured. EDIT THESE TO YOUR REAL FACTS.",
              "type": "string"
            },
            {
              "id": "419cf544-2448-4f20-b587-948ef8b4990a",
              "name": "sitemap_url",
              "value": "https://yourwebsite.com/sitemap.xml",
