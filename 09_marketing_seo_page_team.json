        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "6e88e99d-2969-4289-af97-732868a4ec4a",
      "name": "Passes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3140,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const brief = $('Prep brief').first().json;\nconst fixes = ($input.first().json.output.fixes || []).join('\\n');\nreturn [{ json: { ...brief, fixes } }];"
      },
      "id": "306633b6-8a2d-4930-87f7-2939e660e379",
      "name": "No – send back to writer",
