      "id": "ccf81ebe-19b4-4ae8-af67-3fc7b783981b",
      "name": "Your business",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://places.googleapis.com/v1/places:searchText",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Goog-FieldMask",
              "value": "places.displayName,places.rating,places.userRatingCount,places.websiteUri,places.formattedAddress"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ textQuery: $json.service + ' in ' + $json.city, pageSize: 10 }) }}",
        "options": {}
      },
      "id": "0600146d-a746-4e87-8c31-af0e67321972",
      "name": "Find competitors",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const mine = $('Your business').first().json.business_name.toLowerCase();\nreturn ($input.first().json.places || [])\n  .filter(p => !(p.displayName?.text || '').toLowerCase().includes(mine))\n  .slice(0, 7)\n  .map(p => ({ json: { name: p.displayName?.text, rating: p.rating, reviews: p.userRatingCount, website: p.websiteUri, address: p.formattedAddress } }));"
      },
      "id": "8e13d2fe-3c4f-4e55-afff-fdba85a59359",
      "name": "Shortlist competitors",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Your business').first().json.sitemap_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "be3f3879-d0a1-475e-9554-d17e6f728e6e",
      "name": "Read your sitemap",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const xml = $input.first().json.data || '';\nconst pages = [...xml.matchAll(/<loc>(.*?)<\\/loc>/g)].map(m => m[1]);\nreturn [{ json: { pages } }];"
      },
      "id": "3e094aa1-2fde-44be-9bba-7f3a34d8ef7d",
      "name": "List your pages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a local SEO research agent.\n\nMY BUSINESS: {{ $('Your business').first().json.business_name }}, a {{ $('Your business').first().json.service }} in {{ $('Your business').first().json.city }}.\nTowns I serve: {{ $('Your business').first().json.towns }}\n\nCOMPETITORS NEAR ME (from Google Maps):\n{{ JSON.stringify($('Shortlist competitors').all().map(i => i.json), null, 1) }}\n\nPAGES ALREADY ON MY WEBSITE:\n{{ $json.pages.join('\\n') }}\n\nList the local searches customers make for this service (e.g. 'same-day X near me', 'emergency X in <town>', 'X prices', 'weekend X') that competitors seem to cover but my website has NO page for. Return up to 8 gaps.",
        "hasOutputParser": true
      },
      "id": "4236c53a-5396-4273-9bf0-9dd6496a07e7",
      "name": "Research agent",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "claude-sonnet-5-5",
          "mode": "id"
        },
        "options": {
          "temperature": 0.4
        }
      },
      "id": "1794ec2f-1c6c-4da9-9cfa-5c007b6c2e20",
      "name": "Claude (research)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        1280,
        220
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"gaps\": [\n    {\n      \"search\": \"emergency plumber Round Rock\",\n      \"why\": \"3 competitors rank with a page, you have none\",\n      \"monthly_interest\": \"high\"\n    }\n  ]\n}"
      },
      "id": "d9a08d9b-3a23-42cb-826f-93ff47a40bd8",
      "name": "Gaps output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1420,
        220
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a local SEO strategy agent. From these gaps, pick the ONE page most likely to bring calls for {{ $('Your business').first().json.business_name }} ({{ $('Your business').first().json.service }}, {{ $('Your business').first().json.city }}). Prefer high-intent searches (urgent, near me, a specific town).\n\nGAPS:\n{{ JSON.stringify($json.output.gaps, null, 1) }}",
        "hasOutputParser": true
      },
      "id": "c8b07776-ad68-44ee-aeac-9db8d39cd887",
      "name": "Strategy agent",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1720,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "claude-sonnet-5-5",
          "mode": "id"
        },
        "options": {
          "temperature": 0.4
        }
      },
      "id": "cc0010a6-02ef-41ec-be34-d0b5e8e820fc",
      "name": "Claude (strategy)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        1680,
        220
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"keyword\": \"same-day plumber near me\",\n  \"title\": \"Same-Day Plumber in Austin, Round Rock & Kyle\",\n  \"towns\": \"Austin, Round Rock, Kyle\",\n  \"reason\": \"high intent, no page yet\"\n}"
      },
      "id": "e5f5c1c6-c8e3-4cd5-b99a-22add36eac12",
      "name": "Pick output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1820,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const o = $input.first().json.output;\nreturn [{ json: { keyword: o.keyword, title: o.title, towns: o.towns, fixes: '' } }];"
      },
      "id": "6eddc71f-2701-40fc-98a0-0cf8a2558b60",
      "name": "Prep brief",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2120,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a writing agent for {{ $('Your business').first().json.business_name }}, a {{ $('Your business').first().json.service }} in {{ $('Your business').first().json.city }}.\nWrite a helpful local landing page.\n\nTARGET SEARCH: {{ $json.keyword }}\nWORKING TITLE: {{ $json.title }}\nTOWNS: {{ $json.towns }}\nBUSINESS FACTS (use only these, never invent prices, reviews or guarantees):\n{{ $('Your business').first().json.facts }}\n\nAnswer the real questions a customer asks: what you do, how fast, where, opening hours, how to book. Add a short FAQ (4 questions). Clear headings, short paragraphs, plain HTML (h2, p, ul, li only). End with a call-to-action with the phone number.\n\n{{ $json.fixes ? 'THE EDITOR SENT THIS BACK. FIX ALL OF THESE:\\n' + $json.fixes : '' }}",
        "hasOutputParser": true
      },
      "id": "9c67c866-32a2-4b76-9501-66d5e8de2ed7",
      "name": "Writing agent",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        2340,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "claude-sonnet-5-5",
