        "additionalFields": {}
      },
      "id": "4d226aae-0ec4-4ffc-8121-f1413974990c",
      "name": "Alert CA",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        880,
        -120
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a short WhatsApp (Hinglish, Roman script, max 3 lines) from a small business to client {{ $json.Client }} asking for their {{ $json.Document }}. It was first asked {{ $json.days }} days ago. Tone by stage {{ $json.stage }}: 1 = friendly nudge, 2 = polite but firm, 3 = clear that the filing deadline is at risk. Start with 'Hello {{ $json.Client }} ji', never 'Namaste'. No threats, no penalty amounts, no tax advice. Sign: YOUR FIRM NAME. Output ONLY the message text – no heading, no quotes, no code fences.",
        "hasOutputParser": false
      },
      "id": "9a1856e6-7ec0-4bbc-b640-7e53ba0b2ee9",
      "name": "AI writes follow-up",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
